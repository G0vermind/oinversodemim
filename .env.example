# ==============================================================================
# CONFIGURAÇÕES BÁSICAS DO SISTEMA
# ==============================================================================
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ANALYTICS="none"

# ==============================================================================
# CONTROLE MODULAR DE ATUALIZAÇÕES COMERCIAIS (FEATURE FLAGS)
#
# Cada funcionalidade do plano é ativada/desativada individualmente.
# Altere para "true" para liberar a atualização contratada pelo cliente.
# ==============================================================================

# [v1.1] Motor de eBooks em PDF On-Demand (Formato A5 Editorial)
NEXT_PUBLIC_MODULE_EBOOK_PDF="true"

# [v1.2] Memorial Biográfico Editorial de Heldemarcio Ferreira & Manifesto Lírico
NEXT_PUBLIC_MODULE_BIOGRAFIA_EDITORIAL="true"

# [v1.3] Social Canvas — Gerador de Cards Poéticos Compartilháveis (9:16 e 1:1)
NEXT_PUBLIC_MODULE_SOCIAL_CARDS="true"

# [v1.4] Santuário Sonoro — Áudio Sincronizado por Verso (Audio-Verse Sync)
NEXT_PUBLIC_MODULE_AUDIO_VERSE_SYNC="false"

# [v2.0] Acervo Inteligente — Busca Poética no Acervo, Prisma DB & PWA Offline
NEXT_PUBLIC_MODULE_SEARCH_AND_DB="false"

# ==============================================================================
# GESTÃO EDITORIAL & CMS (KEYSTATIC)
# ==============================================================================
# Em desenvolvimento local, o Keystatic edita diretamente os arquivos em disco (content/ e public/art/).
# Em produção (Vercel), pode operar via GitHub OAuth ou Keystatic Cloud (https://keystatic.cloud)
# Para forçar modo local mesmo em produção: NEXT_PUBLIC_KEYSTATIC_STORAGE_KIND="local"
NEXT_PUBLIC_KEYSTATIC_STORAGE_KIND="local"

# Se utilizar GitHub OAuth em produção:
# KEYSTATIC_SECRET="uma-chave-secreta-aleatoria-de-32-caracteres"
# KEYSTATIC_GITHUB_CLIENT_ID=""
# KEYSTATIC_GITHUB_CLIENT_SECRET=""

