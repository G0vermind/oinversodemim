datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Obra {
  id              String       @id @default(cuid())
  titulo          String
  slug            String       @unique
  descricao       String
  capaUrl         String
  ebookUrl        String?
  preco           Int
  linkVendaFisica String?
  estoqueFisico   Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  poemas          Poema[]
  faixas          FaixaAudio[]
}

model Poema {
  id          String   @id @default(cuid())
  titulo      String
  conteudo    String
  ordem       Int
  publicadoEm DateTime @default(now())
  obraId      String

  obra        Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
}

model FaixaAudio {
  id         String   @id @default(cuid())
  titulo     String
  arquivoUrl String
  duracao    Int
  letra      String?
  obraId     String

  obra       Obra     @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
}

model PerfilAutor {
  id              String   @id @default(cuid())
  nome            String
  chavePix        String
  carteiraStellar String
}
